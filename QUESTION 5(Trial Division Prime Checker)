#include <stdio.h>

int main(void)
{
    int n;
    int checks = 0;

    /* READ n */
    printf("Enter a number: ");
    scanf("%d", &n);

    if (n < 2) {
        printf("Not Prime\n");
        return 0;                      /* STOP */
    }

    for (int i = 2; i <= n - 1; i++) {

        checks = checks + 1;

        if (n % i == 0) {
            printf("Not Prime\n");
            printf("Checks: %d\n", checks);
            return 0;                  /* STOP */
        }
    }

    printf("Prime\n");
    printf("Checks: %d\n", checks);

    return 0;
}

