#include <stdio.h>

int main(void)
{
    long long n;
    long long i;
    int checks = 0;

    /* READ n */
    printf("Enter a number: ");
    scanf("%lld", &n);

    if (n < 2) {
        printf("Not Prime\n");
        return 0;                      /* STOP */
    }

    i = 2;

    while (i * i <= n) {

        checks = checks + 1;

        if (n % i == 0) {
            printf("Not Prime\n");
            printf("Checks: %d\n", checks);
            return 0;                  /* STOP */
        }

        i = i + 1;
    }

    printf("Prime\n");
    printf("Checks: %d\n", checks);

    return 0;
}

//Input

//Prompt	Enter
//Enter a number	any integer, e.g. 17

