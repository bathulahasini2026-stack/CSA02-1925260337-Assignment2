#include <stdio.h>

int main(void)
{
    /* Lookup table: index = marks / 10 */
    char grades[] = {
        'F', 'F', 'F', 'F', 'F',
        'D', 'C', 'B', 'A', 'S', 'S'
    };

    double marks;
    int grade_group;
    char grade;

    /* READ marks */
    printf("Enter marks (0 to 100): ");
    scanf("%lf", &marks);

    if (marks < 0 || marks > 100) {

        printf("Invalid Marks\n");

    } else {

        grade_group = (int)(marks / 10);   /* INTEGER PART OF (marks / 10) */

        grade = grades[grade_group];

        printf("Grade: %c\n", grade);
    }

    return 0;
}

