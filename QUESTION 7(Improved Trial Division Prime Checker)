#include <stdio.h>

int main(void)
{
    long long n;
    long long divisor;
    int checks = 0;

    /* READ n */
    printf("Enter a number: ");
    scanf("%lld", &n);

    if (n < 2) {
        printf("Not Prime\n");
        return 0;                      /* STOP */
    }

    if (n == 2) {
        printf("Prime\n");             /* checks is not displayed here */
        return 0;                      /* STOP */
    }

    checks = checks + 1;               /* the even-number check */

    if (n % 2 == 0) {
        printf("Not Prime\n");
        printf("Checks: %d\n", checks);
        return 0;                      /* STOP */
    }

    divisor = 3;

    while (divisor <= n / divisor) {

        checks = checks + 1;

        if (n % divisor == 0) {
            printf("Not Prime\n");
            printf("Checks: %d\n", checks);
            return 0;                  /* STOP */
        }

        divisor = divisor + 2;         /* only odd divisors */
    }

    printf("Prime\n");
    printf("Checks: %d\n", checks);

    return 0;
}

